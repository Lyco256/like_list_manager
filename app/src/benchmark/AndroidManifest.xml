<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <package android:name="com.lyco256.llm" />
    </queries>
    <application
        android:label="like list manager benchmark"
        android:networkSecurityConfig="@xml/benchmark_network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:label">
        <profileable android:shell="true" />
        <activity
            android:name=".MainActivity"
            tools:node="remove" />
        <activity
            android:name=".BenchmarkMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BenchmarkSnapshotSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            tools:node="remove" />
    </application>
</manifest>
